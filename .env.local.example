# Firebase web config for cloud sync & sharing (Phase 2). Optional — without
# these, Travel OS runs fully offline from localStorage as before.
#
# Get these values from: Firebase console → Project settings → General →
# Your apps → Web app → SDK setup and configuration.
#
# Copy this file to .env.local for local development. For the deployed site,
# set the same names as repository variables (Settings → Secrets and
# variables → Actions → Variables) so .github/workflows/deploy.yml can read
# them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
